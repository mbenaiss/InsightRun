    "ATL (7 days) & CTL (42 days) via EWMA. ACWR = ATL/CTL. Score 0-20 personalized: ATL/CTL × 10 (maintaining = 10/20).": {
      "comment": "Cardiac load EWMA explanation",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ATL (7 days) & CTL (42 days) via EWMA. ACWR = ATL/CTL. Score 0-20 personalized: ATL/CTL × 10 (maintaining = 10/20)."
          }
        },
        "fr": {
