        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vitesse à laquelle vous montez les escaliers, mesurée en mètres par seconde ou en marches par minute."
          }
        }
      }
    },
    "metric.stair_ascent_speed.recommended" : {
