    },
    "Good" : {
      "comment" : "Cadence range: Good\nGCT range: Good\nHRV range: Good\nPower range: Good\nRHR range: Good\nVO range: Good\nVO2 Max range: Good",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bon"
          }
        }
      }
    },
    "Good morning! 🏃" : {
      "comment" : "Daily readiness notification title",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour ! 🏃"
          }
        }
      }
    },
    "Good overall shape. You can train normally with moderate to high intensity." : {
      "comment" : "Message displayed in a recovery insight when the user has a good overall shape and can train normally.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonne forme générale. Vous pouvez vous entraîner normalement avec une intensité modérée à élevée."
          }
        }
      }
    },
    "Good pace consistency across splits. Your cadence of 172 spm is slightly below optimal — aim for 180 spm to improve efficiency." : {
      "comment" : "Blurred teaser text for locked AI analysis about pace consistency",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonne régularité d'allure sur les splits. Votre cadence de 172 ppm est légèrement sous l'optimal ; visez 180 ppm pour améliorer votre efficacité."
          }
        }
      }
    },
    "Good recovery. You can do a moderate to intense workout." : {
      "comment" : "Recovery recommendation - good status",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonne récupération. Vous pouvez effectuer un entraînement modéré à intense."
          }
        }
      }
    },
    "Grant write access to save imported workouts to the Health app." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser l'accès en écriture pour sauvegarder les entraînements importés dans l'app Santé."
          }
        }
      }
