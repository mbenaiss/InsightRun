    "metric.contact_balance.description" : {
      "comment" : "Contact Balance metric description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The symmetry of ground contact time between left and right feet, shown as a percentage split."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La symétrie du temps de contact au sol entre les pieds gauche et droit, exprimée en pourcentage."
          }
        }
      }
    },
    "metric.contact_balance.recommended" : {
      "comment" : "Contact Balance recommended values",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideal: 49.0-51.0% (within 2% of 50/50). Significant asymmetry (>53% or <47%) may indicate imbalances."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idéal : 49,0-51,0% (dans les 2% de 50/50). Une asymétrie significative (>53% ou <47%) peut indiquer des déséquilibres."
          }
        }
      }
    },
    "metric.contact_balance.title" : {
      "comment" : "Contact Balance metric title",
      "extractionState" : "manual",
