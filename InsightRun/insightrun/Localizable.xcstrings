    "metric.running_efficiency.description" : {
      "comment" : "Running Efficiency metric description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A composite metric indicating how efficiently you convert energy into forward motion."
          }
        },
