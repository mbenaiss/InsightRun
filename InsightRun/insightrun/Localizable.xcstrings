    "metric.stair_descent_speed.recommended" : {
      "comment" : "Stair Descent Speed recommended values",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Average adults: 0.6-0.8 m/s. Faster than ascent is normal. Significantly slower may indicate concerns."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adultes moyens : 0,6-0,8 m/s. Plus rapide que la montée est normal. Significativement plus lent peut indiquer des préoccupations."
          }
        }
      }
    },
    "metric.stair_descent_speed.title" : {
      "comment" : "Stair Descent Speed metric title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stair Descent Speed"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitesse de descente d'escaliers"
          }
        }
      }
    },
    "metric.stair_descent_speed.usage" : {
      "comment" : "Stair Descent Speed metric usage",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicates balance, eccentric muscle control, and confidence. Slower descent may suggest injury concerns or reduced stability."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique l'équilibre, le contrôle musculaire excentrique et la confiance. Une descente plus lente peut suggérer des préoccupations de blessure ou une stabilité réduite."
          }
        }
      }
    },
    "metric.stride_length.description" : {
      "comment" : "Stride Length metric description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The average distance covered with each step during running."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La distance moyenne parcourue à chaque pas pendant la course."
          }
        }
      }
    },
    "metric.stride_length.recommended" : {
      "comment" : "Stride Length recommended values",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varies by height and speed. Generally 1.0-1.5 meters for recreational runners, up to 2.0m+ for elite sprinters."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varie selon la taille et la vitesse. Généralement 1,0-1,5 mètre pour les coureurs amateurs, jusqu'à 2,0m+ pour les sprinteurs élite."
          }
        }
      }
    },
    "metric.stride_length.title" : {
      "comment" : "Stride Length metric title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stride Length"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longueur de foulée"
          }
        }
      }
    },
    "metric.stride_length.usage" : {
      "comment" : "Stride Length metric usage",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combined with cadence, determines running speed. Longer strides can increase speed but may increase injury risk if excessive."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combinée à la cadence, détermine la vitesse de course. Des foulées plus longues peuvent augmenter la vitesse mais peuvent accroître le risque de blessure si excessives."
          }
        }
      }
    },
    "metric.vertical_oscillation.description" : {
      "comment" : "Vertical Oscillation metric description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The vertical bounce or up-and-down movement of your center of mass while running, measured in centimeters."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rebond vertical ou mouvement de haut en bas de votre centre de masse pendant la course, mesuré en centimètres."
          }
        }
      }
    },
    "metric.vertical_oscillation.recommended" : {
      "comment" : "Vertical Oscillation recommended values",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elite: 6-8cm, Good: 8-10cm, Average: 10-12cm. Lower values indicate better efficiency."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Élite : 6-8cm, Bon : 8-10cm, Moyen : 10-12cm. Des valeurs plus basses indiquent une meilleure efficacité."
          }
        }
      }
    },
    "metric.vertical_oscillation.title" : {
      "comment" : "Vertical Oscillation metric title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertical Oscillation"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oscillation verticale"
          }
        }
      }
    },
    "metric.vertical_oscillation.usage" : {
      "comment" : "Vertical Oscillation metric usage",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower values indicate more efficient running with less wasted energy. Excessive bounce can increase fatigue and injury risk."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des valeurs plus basses indiquent une course plus efficace avec moins d'énergie gaspillée. Un rebond excessif peut augmenter la fatigue et le risque de blessure."
          }
        }
      }
    },
    "metric.vo2_max.description" : {
