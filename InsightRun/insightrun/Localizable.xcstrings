    },
    "metric.running_efficiency.recommended" : {
      "comment" : "Running Efficiency recommended values",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Values above 75% are considered good. Elite runners often achieve 85%+ efficiency."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des valeurs supérieures à 75% sont considérées comme bonnes. Les coureurs élite atteignent souvent une efficacité de 85%+."
          }
