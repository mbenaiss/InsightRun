            "value" : "Ground Contact Time"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temps de contact au sol"
          }
        }
      }
    },
    "metric.ground_contact_time.usage" : {
      "comment" : "Ground Contact Time metric usage",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shorter contact times typically indicate better running economy and faster speeds. Helps assess running form efficiency."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des temps de contact plus courts indiquent généralement une meilleure économie de course et des vitesses plus rapides. Aide à évaluer l'efficacité de la foulée."
          }
        }
      }
    },
