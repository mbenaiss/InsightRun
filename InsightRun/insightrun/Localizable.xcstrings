        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contact Balance"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Équilibre du contact"
          }
        }
      }
    },
    "metric.contact_balance.usage" : {
      "comment" : "Contact Balance metric usage",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helps identify running imbalances that could lead to injury. Perfect balance is 50/50, but slight variations are normal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aide à identifier les déséquilibres de course pouvant entraîner des blessures. L'équilibre parfait est 50/50, mais de légères variations sont normales."
          }
        }
      }
    },
    "metric.double_support.description" : {
      "comment" : "Double Support metric description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The percentage of gait cycle where both feet are in contact with the ground simultaneously."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pourcentage du cycle de marche où les deux pieds sont en contact avec le sol simultanément."
          }
        }
