    "metric.best_pace.usage" : {
      "comment" : "Best Pace metric usage",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicates your maximum speed capability. Useful for tracking speed improvements and planning interval training."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
