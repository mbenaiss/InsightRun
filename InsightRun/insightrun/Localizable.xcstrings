      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Important indicator of fall risk and overall mobility health. Higher scores indicate better balance and stability."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicateur important du risque de chute et de la santé de la mobilité globale. Des scores plus élevés indiquent un meilleur équilibre et une meilleure stabilité."
