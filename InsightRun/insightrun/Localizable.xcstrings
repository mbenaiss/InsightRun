    "metric.ground_contact_time.description" : {
      "comment" : "Ground Contact Time metric description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The amount of time your foot spends in contact with the ground during each step, measured in milliseconds."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps que votre pied passe en contact avec le sol à chaque pas, mesuré en millisecondes."
          }
        }
      }
    },
    "metric.ground_contact_time.recommended" : {
      "comment" : "Ground Contact Time recommended values",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elite runners: 180-200ms, Advanced: 200-220ms, Recreational: 220-260ms. Lower is generally better."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coureurs élite : 180-200ms, Avancés : 200-220ms, Amateurs : 220-260ms. Plus bas est généralement mieux."
          }
        }
      }
