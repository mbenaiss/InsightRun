      }
    },
    "Your body needs recovery. Prioritize light training or complete rest today." : {
      "comment" : "Message displayed in a recovery insight when the user's recovery score is below 80, advising them to prioritize light training or rest.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre corps a besoin de récupération. Privilégiez un entraînement léger ou un repos complet aujourd'hui."
          }
        }
      }
    },
    "Your data is private" : {
      "comment" : "Onboarding privacy note title",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données sont privées"
          }
        }
      }
    },
    "Your fitness journey is waiting" : {
      "comment" : "Inactivity reminder notification title",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre forme physique vous attend"
          }
        }
      }
    },
    "Your HRV is above your baseline, indicating excellent recovery. This is a good day for high-intensity training if desired." : {
      "comment" : "High HRV recommendation",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre VFC est au-dessus de votre référence, indiquant une excellente récupération. C'est une bonne journée pour un entraînement à haute intensité si souhaité."
          }
        }
      }
    },
    "Your HRV is below your normal range. Consider prioritizing rest, reducing training intensity, and ensuring quality sleep tonight." : {
      "comment" : "Low HRV recommendation",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre VFC est en dessous de votre plage normale. Envisagez de prioriser le repos, réduire l'intensité de l'entraînement et assurer un sommeil de qualité ce soir."
          }
        }
      }
    },
    "Your intelligent running coach" : {
      "comment" : "Onboarding welcome subtitle",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre coach running intelligent"
          }
        }
      }
    },
    "Your intelligent running coach. Detailed metrics, AI analysis, recovery and progression — in one place." : {
      "comment" : "Onboarding welcome subtitle"
    },
    "Your metrics are within normal range. Continue with your current training and recovery routine." : {
      "comment" : "Normal recommendation",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos métriques sont dans la plage normale. Continuez avec votre routine d'entraînement et de récupération actuelle."
          }
        }
      }
    },
    "Your oxygen saturation is lower than optimal. Ensure good ventilation and consider deep breathing exercises." : {
      "comment" : "Low SpO2 recommendation",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre saturation en oxygène est inférieure à l'optimum. Assurez une bonne ventilation et envisagez des exercices de respiration profonde."
          }
        }
      }
    },
    "Your past conversations will appear here" : {
      "comment" : "Empty state subtitle for conversation history",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos conversations passées apparaîtront ici"
          }
        }
      }
    },
    "Your readiness score is %lld/100. %@" : {
      "comment" : "Low readiness notification body",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your readiness score is %1$lld/100. %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre score de readiness est de %lld/100. %@"
          }
        }
      }
    },
    "Your recovery score reflects how well your body has recovered from recent stress and training. A higher score indicates better readiness for intense physical activity." : {
      "comment" : "Recovery explanation",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre score de récupération reflète la qualité de la récupération de votre corps après le stress et l'entraînement récents. Un score plus élevé indique une meilleure disponibilité pour l'activité physique intense."
          }
        }
      }
    },
    "Your request contains content that cannot be processed for safety reasons. Please rephrase your question." : {
      "comment" : "Error: content blocked by safety guardrails",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre demande contient du contenu qui ne peut pas être traité pour des raisons de sécurité. Veuillez reformuler votre question."
          }
        }
      }
    },
    "Your respiratory rate is elevated. This could indicate stress or incomplete recovery. Practice relaxation techniques." : {
      "comment" : "High resp recommendation",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre fréquence respiratoire est élevée. Cela pourrait indiquer du stress ou une récupération incomplète. Pratiquez des techniques de relaxation."
          }
        }
      }
    },
    "Your resting heart rate is elevated. This may indicate stress, dehydration, or incomplete recovery. Consider lighter activity today." : {
      "comment" : "High RHR recommendation",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre fréquence cardiaque au repos est élevée. Cela peut indiquer du stress, une déshydratation ou une récupération incomplète. Envisagez une activité plus légère aujourd'hui."
          }
        }
      }
    },
    "Your resting heart rate is lower than usual, indicating good cardiovascular recovery." : {
      "comment" : "Low RHR recommendation",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre fréquence cardiaque au repos est plus basse que d'habitude, indiquant une bonne récupération cardiovasculaire."
          }
        }
      }
    },
    "Your training load is well balanced. Keep up the good work!" : {
      "comment" : "Normal training status message",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre charge d'entraînement est bien équilibrée. Continuez comme ça !"
