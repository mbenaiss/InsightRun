    },
    "metric.stair_ascent_speed.description" : {
      "comment" : "Stair Ascent Speed metric description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The speed at which you climb stairs, measured in meters per second or steps per minute."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vitesse à laquelle vous montez les escaliers, mesurée en mètres par seconde ou en marches par minute."
          }
        }
      }
    },
    "metric.stair_ascent_speed.recommended" : {
      "comment" : "Stair Ascent Speed recommended values",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Average adults: 0.5-0.7 m/s. Athletes: >1.0 m/s. Slower speeds may indicate reduced mobility."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
