    "metric.running_efficiency.description" : {
      "comment" : "Running Efficiency metric description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A composite metric indicating how efficiently you convert energy into forward motion."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une métrique composite indiquant l'efficacité avec laquelle vous convertissez l'énergie en mouvement vers l'avant."
          }
        }
      }
    },
    "metric.running_efficiency.recommended" : {
      "comment" : "Running Efficiency recommended values",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Values above 75% are considered good. Elite runners often achieve 85%+ efficiency."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des valeurs supérieures à 75% sont considérées comme bonnes. Les coureurs élite atteignent souvent une efficacité de 85%+."
          }
        }
      }
    },
    "metric.running_efficiency.title" : {
      "comment" : "Running Efficiency metric title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Running Efficiency"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efficacité de course"
          }
        }
      }
    },
    "metric.running_efficiency.usage" : {
      "comment" : "Running Efficiency metric usage",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher efficiency means less energy wasted on unnecessary movements. Improves with better form and training."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une efficacité plus élevée signifie moins d'énergie gaspillée en mouvements inutiles. S'améliore avec une meilleure technique et l'entraînement."
          }
        }
      }
    },
    "metric.running_power.description" : {
      "comment" : "Running Power metric description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The mechanical power output during running, measured in watts (W)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La puissance mécanique produite pendant la course, mesurée en watts (W)."
          }
        }
      }
    },
    "metric.running_power.recommended" : {
      "comment" : "Running Power recommended values",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Easy pace: 200-250W, Moderate: 250-300W, Hard: 300-350W, Max effort: >350W. Varies by weight and fitness."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
