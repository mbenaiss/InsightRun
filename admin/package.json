{
  "name": "insightrun-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "pages:build": "npx opennextjs-cloudflare build",
    "pages:deploy": "npx opennextjs-cloudflare deploy",
    "pages:dev": "npx opennextjs-cloudflare preview",
    "preview": "bun run pages:build && bun run pages:dev",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@opennextjs/cloudflare": "1.20.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "autoprefixer": "^10.6.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.131.1"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
