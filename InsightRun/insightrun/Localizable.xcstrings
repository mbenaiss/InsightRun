      }
    },
    "metric.contact_balance.recommended" : {
      "comment" : "Contact Balance recommended values",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideal: 49.0-51.0% (within 2% of 50/50). Significant asymmetry (>53% or <47%) may indicate imbalances."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idéal : 49,0-51,0% (dans les 2% de 50/50). Une asymétrie significative (>53% ou <47%) peut indiquer des déséquilibres."
          }
        }
      }
    },
    "metric.contact_balance.title" : {
      "comment" : "Contact Balance metric title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contact Balance"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Équilibre du contact"
          }
        }
      }
    },
    "metric.contact_balance.usage" : {
      "comment" : "Contact Balance metric usage",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helps identify running imbalances that could lead to injury. Perfect balance is 50/50, but slight variations are normal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aide à identifier les déséquilibres de course pouvant entraîner des blessures. L'équilibre parfait est 50/50, mais de légères variations sont normales."
          }
        }
      }
    },
    "metric.double_support.description" : {
      "comment" : "Double Support metric description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The percentage of gait cycle where both feet are in contact with the ground simultaneously."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pourcentage du cycle de marche où les deux pieds sont en contact avec le sol simultanément."
          }
        }
      }
    },
    "metric.double_support.recommended" : {
      "comment" : "Double Support recommended values",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal walking: 20-25%, Slower pace: 25-30%. Lower values indicate faster, more efficient gait."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marche normale : 20-25%, Allure plus lente : 25-30%. Des valeurs plus basses indiquent une démarche plus rapide et efficace."
          }
        }
      }
    },
    "metric.double_support.title" : {
      "comment" : "Double Support metric title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double Support"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double appui"
          }
        }
      }
    },
    "metric.double_support.usage" : {
      "comment" : "Double Support metric usage",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicates walking efficiency and balance. Higher values may suggest reduced mobility or confidence."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique l'efficacité de la marche et l'équilibre. Des valeurs plus élevées peuvent suggérer une mobilité ou une confiance réduite."
          }
        }
      }
    },
    "metric.ground_contact_time.description" : {
      "comment" : "Ground Contact Time metric description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The amount of time your foot spends in contact with the ground during each step, measured in milliseconds."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps que votre pied passe en contact avec le sol à chaque pas, mesuré en millisecondes."
          }
        }
      }
    },
    "metric.ground_contact_time.recommended" : {
      "comment" : "Ground Contact Time recommended values",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elite runners: 180-200ms, Advanced: 200-220ms, Recreational: 220-260ms. Lower is generally better."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coureurs élite : 180-200ms, Avancés : 200-220ms, Amateurs : 220-260ms. Plus bas est généralement mieux."
          }
        }
      }
    },
    "metric.ground_contact_time.title" : {
      "comment" : "Ground Contact Time metric title",
      "extractionState" : "manual",
      "localizations" : {
