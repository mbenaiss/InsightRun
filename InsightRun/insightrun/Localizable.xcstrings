    "metric.stair_descent_speed.recommended" : {
      "comment" : "Stair Descent Speed recommended values",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Average adults: 0.6-0.8 m/s. Faster than ascent is normal. Significantly slower may indicate concerns."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adultes moyens : 0,6-0,8 m/s. Plus rapide que la montée est normal. Significativement plus lent peut indiquer des préoccupations."
          }
        }
      }
    },
    "metric.stair_descent_speed.title" : {
      "comment" : "Stair Descent Speed metric title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stair Descent Speed"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitesse de descente d'escaliers"
          }
        }
      }
    },
    "metric.stair_descent_speed.usage" : {
      "comment" : "Stair Descent Speed metric usage",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicates balance, eccentric muscle control, and confidence. Slower descent may suggest injury concerns or reduced stability."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique l'équilibre, le contrôle musculaire excentrique et la confiance. Une descente plus lente peut suggérer des préoccupations de blessure ou une stabilité réduite."
          }
        }
      }
    },
    "metric.stride_length.description" : {
      "comment" : "Stride Length metric description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The average distance covered with each step during running."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La distance moyenne parcourue à chaque pas pendant la course."
          }
        }
      }
    },
    "metric.stride_length.recommended" : {
      "comment" : "Stride Length recommended values",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varies by height and speed. Generally 1.0-1.5 meters for recreational runners, up to 2.0m+ for elite sprinters."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varie selon la taille et la vitesse. Généralement 1,0-1,5 mètre pour les coureurs amateurs, jusqu'à 2,0m+ pour les sprinteurs élite."
          }
        }
      }
    },
    "metric.stride_length.title" : {
      "comment" : "Stride Length metric title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stride Length"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longueur de foulée"
          }
        }
      }
    },
    "metric.stride_length.usage" : {
      "comment" : "Stride Length metric usage",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combined with cadence, determines running speed. Longer strides can increase speed but may increase injury risk if excessive."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combinée à la cadence, détermine la vitesse de course. Des foulées plus longues peuvent augmenter la vitesse mais peuvent accroître le risque de blessure si excessives."
          }
        }
      }
    },
    "metric.vertical_oscillation.description" : {
      "comment" : "Vertical Oscillation metric description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The vertical bounce or up-and-down movement of your center of mass while running, measured in centimeters."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rebond vertical ou mouvement de haut en bas de votre centre de masse pendant la course, mesuré en centimètres."
          }
        }
      }
    },
    "metric.vertical_oscillation.recommended" : {
      "comment" : "Vertical Oscillation recommended values",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elite: 6-8cm, Good: 8-10cm, Average: 10-12cm. Lower values indicate better efficiency."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Élite : 6-8cm, Bon : 8-10cm, Moyen : 10-12cm. Des valeurs plus basses indiquent une meilleure efficacité."
          }
        }
      }
    },
    "metric.vertical_oscillation.title" : {
      "comment" : "Vertical Oscillation metric title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertical Oscillation"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oscillation verticale"
          }
        }
      }
    },
    "metric.vertical_oscillation.usage" : {
      "comment" : "Vertical Oscillation metric usage",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower values indicate more efficient running with less wasted energy. Excessive bounce can increase fatigue and injury risk."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des valeurs plus basses indiquent une course plus efficace avec moins d'énergie gaspillée. Un rebond excessif peut augmenter la fatigue et le risque de blessure."
          }
        }
      }
    },
    "metric.vo2_max.description" : {
      "comment" : "VO2 Max metric description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The maximum rate of oxygen consumption during intense exercise, measured in ml/kg/min."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le taux maximal de consommation d'oxygène pendant un exercice intense, mesuré en ml/kg/min."
          }
        }
      }
    },
    "metric.vo2_max.recommended" : {
      "comment" : "VO2 Max recommended values",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Men: Excellent >50, Good 40-50, Average 30-40. Women: Excellent >45, Good 35-45, Average 25-35."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hommes : Excellent >50, Bon 40-50, Moyen 30-40. Femmes : Excellent >45, Bon 35-45, Moyen 25-35."
          }
        }
      }
    },
    "metric.vo2_max.title" : {
      "comment" : "VO2 Max metric title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO2 Max"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO2 Max"
          }
        }
      }
    },
    "metric.vo2_max.usage" : {
      "comment" : "VO2 Max metric usage",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Key indicator of cardiovascular fitness and endurance capacity. Higher values indicate better aerobic fitness."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicateur clé de la condition cardiovasculaire et de la capacité d'endurance. Des valeurs plus élevées indiquent une meilleure forme aérobique."
          }
        }
      }
    },
    "metric.walking_asymmetry.description" : {
      "comment" : "Walking Asymmetry metric description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measures differences in gait pattern between left and right sides, shown as a percentage."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesure les différences dans le schéma de marche entre les côtés gauche et droit, exprimées en pourcentage."
          }
        }
      }
    },
    "metric.walking_asymmetry.recommended" : {
      "comment" : "Walking Asymmetry recommended values",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal: <15%, Asymmetric: 15-20%, High Asymmetry: >20%. Lower values are better."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal : <15%, Asymétrique : 15-20%, Haute asymétrie : >20%. Des valeurs plus basses sont meilleures."
          }
        }
      }
    },
    "metric.walking_asymmetry.title" : {
      "comment" : "Walking Asymmetry metric title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walking Asymmetry"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asymétrie de marche"
          }
        }
      }
    },
    "metric.walking_asymmetry.usage" : {
      "comment" : "Walking Asymmetry metric usage",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher asymmetry may indicate injury, weakness, or biomechanical issues. Can help identify rehabilitation needs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une asymétrie plus élevée peut indiquer une blessure, une faiblesse ou des problèmes biomécaniques. Peut aider à identifier les besoins de rééducation."
          }
        }
      }
    },
    "metric.walking_speed.description" : {
      "comment" : "Walking Speed metric description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your average walking speed during the workout, measured in km/h or mph."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre vitesse de marche moyenne pendant l'entraînement, mesurée en km/h ou mph."
          }
        }
      }
    },
    "metric.walking_speed.recommended" : {
      "comment" : "Walking Speed recommended values",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Average: 4.8-6.4 km/h (3-4 mph), Brisk: 6.4-8.0 km/h (4-5 mph), Very brisk: >8.0 km/h (>5 mph)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moyen : 4,8-6,4 km/h (3-4 mph), Vif : 6,4-8,0 km/h (4-5 mph), Très vif : >8,0 km/h (>5 mph)."
          }
        }
      }
    },
    "metric.walking_speed.title" : {
      "comment" : "Walking Speed metric title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walking Speed"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitesse de marche"
          }
        }
      }
    },
    "metric.walking_speed.usage" : {
      "comment" : "Walking Speed metric usage",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predictor of overall health and fitness. Faster walking speeds are associated with better cardiovascular health."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prédicteur de la santé et de la forme physique globales. Des vitesses de marche plus rapides sont associées à une meilleure santé cardiovasculaire."
          }
        }
      }
    },
    "metric.walking_steadiness.description" : {
      "comment" : "Walking Steadiness metric description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measures gait stability and balance during walking, expressed as a percentage."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesure la stabilité de la démarche et l'équilibre pendant la marche, exprimée en pourcentage."
          }
        }
      }
    },
    "metric.walking_steadiness.recommended" : {
      "comment" : "Walking Steadiness recommended values",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OK: >80%, Low: 40-80%, Very Low: <40%. Higher scores indicate better stability."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correct : >80%, Faible : 40-80%, Très faible : <40%. Des scores plus élevés indiquent une meilleure stabilité."
          }
        }
      }
    },
    "metric.walking_steadiness.title" : {
      "comment" : "Walking Steadiness metric title",
