      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher efficiency means less energy wasted on unnecessary movements. Improves with better form and training."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une efficacité plus élevée signifie moins d'énergie gaspillée en mouvements inutiles. S'améliore avec une meilleure technique et l'entraînement."
          }
        }
      }
    },
    "metric.running_power.description" : {
      "comment" : "Running Power metric description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
