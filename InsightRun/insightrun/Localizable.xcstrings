    "metric.running_power.recommended" : {
      "comment" : "Running Power recommended values",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Easy pace: 200-250W, Moderate: 250-300W, Hard: 300-350W, Max effort: >350W. Varies by weight and fitness."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
